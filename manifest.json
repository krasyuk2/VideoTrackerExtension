{
  "name": "VideoTrackerExtension",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "host_permissions": ["<all_urls>"],
  "permissions": [
    "alarms",
    "activeTab",
    "scripting",
    "tabs"
  ]
}